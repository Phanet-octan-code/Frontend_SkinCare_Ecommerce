# ==============================================================================
# SKINORA REACT FRONTEND — ENVIRONMENT CONFIGURATION
# ==============================================================================
# In development:
# VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
#
# In production:
# Set this to the canonical HTTPS backend URL pointing to the /api/v1 prefix
VITE_API_BASE_URL=https://api.skinora.com/api/v1
VITE_APP_NAME="Skinora Clinical Dispensary"

# Optional client-side performance and analytics
VITE_ENABLE_ANALYTICS=false
VITE_GA_TRACKING_ID=
